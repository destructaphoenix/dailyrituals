{
  "name": "rituals-native",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/design_handoff_plus_compliance/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-native-purchases))"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/baloo-2": "^0.2.3",
    "@expo-google-fonts/fredoka": "^0.2.3",
    "@expo-google-fonts/nunito": "^0.2.3",
    "@expo-google-fonts/quicksand": "^0.2.3",
    "@expo/metro-runtime": "~3.2.3",
    "@expo/ngrok": "^4.1.0",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-font": "~12.0.0",
    "expo-linear-gradient": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "jest-expo": "~51.0.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-purchases": "^10.2.0",
    "react-native-purchases-ui": "^10.2.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^13.3.3",
    "jest": "^29.7.0",
    "react-test-renderer": "^18.2.0"
  },
  "private": true
}
