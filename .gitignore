# Generated test fixture (regenerate with node scripts/gen-v2-fixture.js)
scripts/daily-rituals-v2-fixture.json

# Store screenshots: raw emulator captures are disposable (regenerate with
# `npm run shots`); the framed store/play/ assets ARE the deliverable and are
# committed, so they survive a fresh clone.
store/raw/
# maestro's per-run artifacts (logs, hierarchies, the captures before they are
# moved into store/raw/) — disposable, kept only to debug a failed run.
store/.maestro-out/

# Python
__pycache__/
*.pyc

# Sky footage. Raw clips in, encoded clips out — neither belongs in git, a
# build or an OTA (docs/playbook.md -> "Plus skies": the clips are downloaded
# from R2 at runtime, never bundled). sky-src/README.md is the exception: it
# explains the folder to a fresh clone. See scripts/encode-sky.py.
sky-src/*
!sky-src/README.md
sky-build/
